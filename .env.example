# ---------- Runtime ----------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
TZ=UTC
# Distinguishes replicas when running `docker compose up --scale api=3` (M8).
INSTANCE_ID=

# ---------- Postgres (M0, M1, M8) ----------
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=overbook
DB_PASSWORD=overbook
DB_NAME=overbook
# Q58 Connection Pooling: too large starves the DB, too small queues requests.
DB_POOL_MAX=10

# ---------- Redis (M3, M4, M7) ----------
REDIS_HOST=redis
REDIS_PORT=6379

# ---------- Kafka (M5, M6) ----------
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=overbook
KAFKA_CONSUMER_GROUP=overbook-notifications
KAFKA_TOPIC_BOOKING=booking.events
KAFKA_TOPIC_RETRY=booking.events.retry
KAFKA_TOPIC_DLQ=booking.events.dlq

# ---------- M1: Race condition ----------
# none        -> naive read-modify-write, oversells on purpose (the bug)
# pessimistic -> SELECT ... FOR UPDATE (Q57, best for flash sales)
# optimistic  -> version column + retry on mismatch (Q57)
BOOKING_LOCK_STRATEGY=pessimistic

# ---------- M3/M4: Caching ----------
CACHE_ENABLED=true
CACHE_TTL_SECONDS=30
# Q59 Cache Stampede: jitter spreads out expiry; single-flight lets only one
# request refill the key; stale-while-revalidate serves stale data meanwhile.
CACHE_TTL_JITTER_SECONDS=10
CACHE_STAMPEDE_PROTECTION=true
CACHE_LOCK_TTL_MS=5000
CACHE_STALE_SECONDS=60

# ---------- M5: Outbox ----------
OUTBOX_ENABLED=true
OUTBOX_RELAY_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10
# Fault injection: crash right after COMMIT, before the relay can publish (M5 step 2).
FAULT_CRASH_AFTER_BOOKING_COMMIT=false
# Publish directly from the service instead of the outbox (the naive, lossy path).
DIRECT_PUBLISH_MODE=false

# ---------- M6: Consumer retry / DLQ / backpressure ----------
NOTIFICATION_FAILURE_RATE=0
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_BASE_MS=500
NOTIFICATION_RETRY_MAX_MS=30000
# Backpressure (Q61): cap in-flight work per consumer instance.
NOTIFICATION_CONCURRENCY=10
CONSUMER_ENABLED=true

# ---------- M7: Rate limiting ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_PER_SECOND=10

# ---------- M8: Graceful shutdown ----------
SHUTDOWN_DRAIN_MS=5000
